.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Local configuration, secrets, and generated files
.idea/
.kotlin/
local.properties
.env
.env.*
backend/.dev.vars*
backend/.env*
!backend/.dev.vars.example
!backend/.env.example
backend/node_modules/
backend/.wrangler/
backend/coverage/
*.apk
.DS_Store
